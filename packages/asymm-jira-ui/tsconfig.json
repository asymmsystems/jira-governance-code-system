{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "jsx": "react",
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../../apps/fourrealities/node_modules/@types/react", "../../apps/fourrealities/node_modules/react"],
      "@forge/react": ["../../apps/fourrealities/node_modules/@forge/react"]
    },
    "typeRoots": ["../../apps/fourrealities/node_modules/@types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
