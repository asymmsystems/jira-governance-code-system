{
  "name": "cascadeplan-jira",
  "version": "1.0.0",
  "description": "Visual WBS Planning, Resource Utilization Heatmaps and Milestone Dependencies for Jira (CascadePlan)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:ui",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "build:ui": "tools/node_modules/.bin/esbuild src/frontend/main.ts --bundle --format=iife --target=es2020 --outfile=static/frontend/build/app.js --log-level=warning"
  },
  "keywords": [
    "atlassian",
    "forge",
    "jira",
    "planning",
    "wbs",
    "gantt",
    "resource-management",
    "utilization",
    "dependencies"
  ],
  "author": "Fahim Farook",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@asymm/jira-ui": "file:../../packages/asymm-jira-ui",
    "@forge/api": "^8.4.0",
    "@forge/bridge": "^7.2.1",
    "@forge/kvs": "^2.1.1",
    "@forge/react": "^12.4.0",
    "@forge/resolver": "^2.0.2",
    "@forge/storage": "^2.0.3",
    "react": "^18.3.1"
  },
  "overrides": {
    "prosemirror-view": "^1.42.3"
  }
}
